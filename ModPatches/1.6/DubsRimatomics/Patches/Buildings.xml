<?xml version="1.0" encoding="utf-8" ?>
<!-- Dubs Rimatomics: EMM material coverage. -->
<Patch>
  <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
    <xpath>/Defs/ThingDef[defName="PlutoniumProcessor" or defName="RadiationShielding"]/costList/Steel</xpath>
    <newMaterial>EM_Titanium</newMaterial>
    <percentage>50</percentage>
    <extraCostFactor>0.8</extraCostFactor>
  </Operation>
  <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
    <xpath>/Defs/ThingDef[defName="DU_Blastdoor" or defName="PPCRailgun" or defName="TableRimatomicsMachining"]/costList/Steel</xpath>
    <newMaterial>EM_Titanium</newMaterial>
    <percentage>100</percentage>
    <extraCostFactor>0.8</extraCostFactor>
  </Operation>
  <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
    <xpath>/Defs/ThingDef[defName="CoolingRadiator"]/costList/Steel</xpath>
    <newMaterial>EM_Copper</newMaterial>
    <percentage>100</percentage>
    <extraCostFactor>1.75</extraCostFactor>
  </Operation>
  <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
    <xpath>/Defs/ThingDef[defName="PlutoniumProcessor" or defName="RadiationShielding"]/costList/Steel</xpath>
    <newMaterial>EM_Lead</newMaterial>
    <percentage>50</percentage>
    <extraCostFactor>1.25</extraCostFactor>
  </Operation>
</Patch>
