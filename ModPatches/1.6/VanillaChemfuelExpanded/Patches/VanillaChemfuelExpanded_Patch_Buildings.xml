<?xml version="1.0" encoding="utf-8" ?>
<!-- Vanilla Chemfuel Expanded: EMM material coverage. -->
<Patch>
  <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
    <xpath>/Defs/ThingDef[defName="VCHE_ChemfuelTap" or defName="VCHE_DeepchemDrain" or defName="VCHE_DeepchemPipe" or defName="VCHE_DeepchemTap" or defName="VCHE_DeepchemValve" or defName="VCHE_UndergroundDeepchemPipe"]/costList/Steel</xpath>
    <newMaterial>EM_StainlessSteel</newMaterial>
    <percentage>100</percentage>
    <extraCostFactor>0.75</extraCostFactor>
  </Operation>
  <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
    <xpath>/Defs/ThingDef[defName="PS_DeepchemRefinery" or defName="VCHE_DeepchemPumpjack"]/costList/Steel</xpath>
    <newMaterial>EM_Titanium</newMaterial>
    <percentage>100</percentage>
    <extraCostFactor>0.8</extraCostFactor>
  </Operation>
</Patch>
