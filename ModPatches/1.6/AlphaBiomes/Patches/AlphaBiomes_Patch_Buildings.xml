<?xml version="1.0" encoding="utf-8" ?>
<!-- Alpha Biomes: EMM material coverage. -->
<Patch>
  <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
    <xpath>/Defs/ThingDef[defName="AB_PropaneStove" or defName="AB_PropaneTap"]/costList/Steel</xpath>
    <newMaterial>EM_StainlessSteel</newMaterial>
    <percentage>100</percentage>
    <extraCostFactor>0.75</extraCostFactor>
  </Operation>
  <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
    <xpath>/Defs/ThingDef[defName="AB_PropaneSmelter" or defName="AB_PropaneTableMachining" or defName="AB_SlimeCompressor"]/costList/Steel</xpath>
    <newMaterial>EM_TemperedSteel</newMaterial>
    <percentage>100</percentage>
  </Operation>
  <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
    <xpath>/Defs/ThingDef[defName="AB_PropaneHeater"]/costList/Steel</xpath>
    <newMaterial>EM_Copper</newMaterial>
    <percentage>100</percentage>
    <extraCostFactor>1.75</extraCostFactor>
  </Operation>
</Patch>
