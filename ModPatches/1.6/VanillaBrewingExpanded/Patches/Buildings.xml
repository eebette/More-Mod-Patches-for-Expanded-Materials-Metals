<?xml version="1.0" encoding="utf-8" ?>
<!-- Vanilla Brewing Expanded: EMM material coverage. -->
<Patch>
  <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
    <xpath>/Defs/ThingDef[defName="VBE_AmbrandyDistillery" or defName="VBE_GinStill"]/costList/Steel</xpath>
    <newMaterial>EM_StainlessSteel</newMaterial>
    <percentage>50</percentage>
    <extraCostFactor>0.75</extraCostFactor>
  </Operation>
  <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
    <xpath>/Defs/ThingDef[defName="VBE_SodaFountain"]/costList/Steel</xpath>
    <newMaterial>EM_StainlessSteel</newMaterial>
    <percentage>100</percentage>
    <extraCostFactor>0.75</extraCostFactor>
  </Operation>
  <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
    <xpath>/Defs/ThingDef[defName="VBE_AmbrandyDistillery" or defName="VBE_GinStill"]/costList/Steel</xpath>
    <newMaterial>EM_Copper</newMaterial>
    <percentage>50</percentage>
    <extraCostFactor>1.75</extraCostFactor>
  </Operation>
</Patch>
