<?xml version="1.0" encoding="utf-8" ?>
<!-- Vanilla Furniture Expanded - Production: EMM material coverage. -->
<Patch>
  <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
    <xpath>/Defs/ThingDef[defName="VFE_KitchenSinkCabinet" or defName="VFE_TableButcherElectric" or defName="VFE_TableStoveLarge"]/costList/Steel</xpath>
    <newMaterial>EM_StainlessSteel</newMaterial>
    <percentage>100</percentage>
    <extraCostFactor>0.75</extraCostFactor>
  </Operation>
  <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
    <xpath>/Defs/ThingDef[defName="VFE_ComponentFabricationBench" or defName="VFE_FueledSmelter" or defName="VFE_TableMachiningLarge"]/costList/Steel</xpath>
    <newMaterial>EM_Titanium</newMaterial>
    <percentage>100</percentage>
    <extraCostFactor>0.8</extraCostFactor>
  </Operation>
</Patch>
